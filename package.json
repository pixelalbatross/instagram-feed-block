{
  "name": "outstand-instagram-feed",
  "version": "1.2.0",
  "description": "Display Instagram posts using a customizable Gutenberg block with list and grid layouts.",
  "contributors": [
    {
      "name": "S\u00e9rgio Santos",
      "url": "https://s3rgiosan.dev",
      "role": "developer"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/pixelalbatross/outstand-instagram-feed"
  },
  "license": "GPL-3.0-or-later",
  "main": "build/index.js",
  "scripts": {
    "build": "wp-scripts build",
    "format": "wp-scripts format",
    "format:src": "wp-scripts format src",
    "lint:css": "wp-scripts lint-style",
    "lint:js": "wp-scripts lint-js",
    "packages-update": "wp-scripts packages-update",
    "plugin-zip": "wp-scripts plugin-zip",
    "start": "wp-scripts start",
    "translate": "npm run translate:pot && npm run translate:update",
    "translate:pot": "wp i18n make-pot . languages/outstand-instagram-feed.pot --exclude=src",
    "translate:update": "wp i18n update-po languages/outstand-instagram-feed.pot languages/*.po",
    "translate:compile": "npm run translate:mo && npm run translate:js",
    "translate:js": "wp i18n make-json languages --no-purge",
    "translate:mo": "wp i18n make-mo languages languages"
  },
  "devDependencies": {
    "@wordpress/env": "^10.39.0",
    "@wordpress/scripts": "^30.12.0"
  },
  "dependencies": {
    "@wordpress/icons": "^10.32.0",
    "clsx": "^2.1.1"
  }
}
